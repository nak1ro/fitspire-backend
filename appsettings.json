{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JWT": {
    "SigningKey": "",
    "Issuer": "FitspireAPI",
    "Audience": "FitspireClient"
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8081"
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Startup": {
    "ApplyMigrationsOnStartup": true
  },
  "DataProtection": {
    "ServiceUri": "",
    "ContainerName": ""
  },
  "Email": {
    "UseMockEmail": true
  },
  "Resend": {
    "ApiKey": "",
    "SenderEmail": "noreply@yourdomain.com"
  },
  "OpenAI": {
    "Enabled": false,
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-5-mini",
    "TimeoutSeconds": 45,
    "MaxOutputTokens": 1200,
    "WorkerPollSeconds": 10,
    "ProcessingLeaseSeconds": 180
  },
  "MediaStorage": {
    "ContainerName": "fitspire-media",
    "ConnectionString": "UseDevelopmentStorage=true",
    "ServiceUrl": "",
    "UploadSasMinutes": 15,
    "ReadSasMinutes": 30,
    "PendingUploadLifetimeMinutes": 60,
    "CleanupIntervalMinutes": 15,
    "ProcessingTimeoutMinutes": 120,
    "UnattachedReadyLifetimeMinutes": 1440,
    "CleanupBatchSize": 50,
    "MaxPendingUploadsPerUser": 20,
    "ProfilePictureMaxBytes": 15728640,
    "PostImageMaxBytes": 31457280,
    "BodyProgressPhotoMaxBytes": 31457280,
    "MaxDecodedPixels": 40000000,
    "PostImageLimit": 10
  }
}
